{
  "name": "aether",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev:engine": "npm run dev --workspace @aether/engine",
    "dev:web": "npm run dev --workspace @aether/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "precommit": "npm run lint:staged && npm run knip",
    "prepare": "husky",
    "test": "npm run test:unit && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/node": "24.13.3",
    "@vue/eslint-config-prettier": "10.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "knip": {
    "workspaces": {
      "apps/web": {
        "ignoreDependencies": [
          "vue",
          "vue-router",
          "vue-tsc"
        ]
      }
    }
  }
}
